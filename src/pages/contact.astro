---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact — Hajime Shimoyama" description="パブリックアート・空間デザインのご相談、制作のご依頼はこちらから。Hajime Shimoyama へのお問い合わせ窓口です。">
  <div class="wrap contact">
    <h1 class="visually-hidden">Contact — Hajime Shimoyama</h1>
    <p class="contact__intro">パブリックアート・空間デザインのご相談、制作のご依頼はこちらから承ります。</p>
    <p class="contact__status js-contact-status" hidden></p>
    <form name="contact" method="POST" action="/contact-handler.php" class="contact__form">
      <input type="hidden" name="loaded-at" class="js-loaded-at" value="" />
      <p class="contact__honeypot"><label>Don't fill this out: <input name="bot-field" /></label></p>

      <label class="contact__field">
        <span>Name *</span>
        <input type="text" name="name" autocomplete="name" required />
      </label>

      <label class="contact__field">
        <span>Email Address *</span>
        <input type="email" name="email" autocomplete="email" required />
      </label>

      <label class="contact__field">
        <span>Message *</span>
        <textarea name="message" rows="6" required></textarea>
      </label>

      <button type="submit" class="contact__submit">Submit</button>
    </form>

    <a href="/" class="contact__back">↑ Back to Top</a>
  </div>

  <script>
    const loadedAtEl = document.querySelector<HTMLInputElement>('.js-loaded-at');
    if (loadedAtEl) loadedAtEl.value = String(Math.floor(Date.now() / 1000));

    const statusEl = document.querySelector<HTMLParagraphElement>('.js-contact-status');
    const status = new URLSearchParams(window.location.search).get('status');
    const messages: Record<string, string> = {
      sent: 'お問い合わせを送信しました。ありがとうございます。',
      invalid: '入力内容をご確認の上、もう一度お試しください。',
      error: '送信に失敗しました。お手数ですが時間をおいて再度お試しください。',
    };
    if (statusEl && status && messages[status]) {
      statusEl.textContent = messages[status];
      statusEl.dataset.status = status;
      statusEl.hidden = false;
    }
  </script>
</BaseLayout>

<style>
  .contact {
    max-width: 32rem;
    padding-block: clamp(1rem, 4vw, 2rem) clamp(3rem, 8vw, 6rem);
  }

  .contact__intro {
    color: var(--color-text-muted);
    font-size: 0.95rem;
    line-height: 1.9;
    margin: 0 0 clamp(2rem, 5vw, 3rem);
  }

  .contact__status {
    font-size: 0.9rem;
    padding: 0.75rem 1rem;
    margin: -1rem 0 2rem;
    border: 1px solid var(--color-border);
    color: var(--color-text);
  }

  .contact__status[data-status="invalid"],
  .contact__status[data-status="error"] {
    border-color: var(--color-text);
  }

  .contact__honeypot {
    position: absolute;
    left: -9999px;
  }

  .contact__form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-bottom: clamp(2.5rem, 6vw, 4rem);
  }

  .contact__field {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-size: 0.95rem;
    color: var(--color-text-muted);
  }

  .contact__field input,
  .contact__field textarea {
    font-family: inherit;
    font-size: 1.05rem;
    color: var(--color-text);
    background: transparent;
    border: none;
    border-bottom: 1px solid var(--color-border);
    padding: 0.6rem 0;
    resize: vertical;
  }

  .contact__field input:focus,
  .contact__field textarea:focus {
    outline: none;
    border-bottom-color: var(--color-text);
  }

  .contact__submit {
    align-self: center;
    margin-top: 1rem;
    padding: 0.6rem 2.5rem;
    font: inherit;
    font-family: var(--font-serif);
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--color-text);
    background: transparent;
    border: 1px solid var(--color-text);
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .contact__submit:hover {
    background: var(--color-text);
    color: var(--color-bg);
  }

  .contact__back {
    display: block;
    text-align: center;
    color: var(--color-text-muted);
  }
</style>
