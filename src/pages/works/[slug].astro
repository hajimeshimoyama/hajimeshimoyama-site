---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const works = await getCollection('works');
  return works.map((work) => ({
    params: { slug: work.id },
    props: { work },
  }));
}

const { work } = Astro.props;
const { title, titleEn, year, venue, period, materials, size, images, imageGroups, coverImage, video } = work.data;
const gallery = imageGroups
  ? imageGroups.flatMap((g) => g.images)
  : images.length > 0
    ? images
    : [coverImage];
const { Content } = await render(work);
---

<BaseLayout title={`${title} — Hajime Shimoyama`}>
  <article class="wrap work-detail">
    <header class="work-detail__header">
      <h1>{title}</h1>
      {titleEn && <p class="work-detail__title-en">{titleEn}</p>}
      {venue && <p class="work-detail__meta">{venue}</p>}
      {period && <p class="work-detail__meta">{period}</p>}
      <p class="work-detail__year">{year}</p>
    </header>

    {imageGroups ? (
      imageGroups.map((group) => (
        <section class="work-detail__gallery-group">
          <h2 class="work-detail__gallery-group-label">{group.label}</h2>
          <div class="work-detail__gallery">
            {group.images.map((src) => (
              <button type="button" class="work-detail__gallery-item js-lightbox-open" data-src={src}>
                <img src={src} alt={`${title} ${group.label}`} loading="lazy" />
              </button>
            ))}
          </div>
        </section>
      ))
    ) : (
      <div class="work-detail__gallery work-detail__gallery--standalone">
        {gallery.map((src) => (
          <button type="button" class="work-detail__gallery-item js-lightbox-open" data-src={src}>
            <img src={src} alt={title} loading="lazy" />
          </button>
        ))}
      </div>
    )}

    <div class="lightbox js-lightbox" hidden>
      <button type="button" class="lightbox__close js-lightbox-close" aria-label="閉じる">×</button>
      {gallery.length > 1 && (
        <>
          <button type="button" class="lightbox__nav lightbox__nav--prev js-lightbox-prev" aria-label="前の画像">‹</button>
          <button type="button" class="lightbox__nav lightbox__nav--next js-lightbox-next" aria-label="次の画像">›</button>
        </>
      )}
      <img class="lightbox__image js-lightbox-image" src="" alt="" />
    </div>

    {video && (
      <div class="work-detail__video">
        <video src={video} controls playsinline preload="metadata"></video>
      </div>
    )}

    {(materials || size) && (
      <dl class="work-detail__specs">
        {materials && (
          <>
            <dt>素材</dt>
            <dd>{materials}</dd>
          </>
        )}
        {size && (
          <>
            <dt>サイズ</dt>
            <dd>{size}</dd>
          </>
        )}
      </dl>
    )}

    <div class="work-detail__body">
      <Content />
    </div>

    <a href="/" class="work-detail__back">↑ Back to Top</a>
  </article>
</BaseLayout>

<script>
  const lightbox = document.querySelector<HTMLDivElement>('.js-lightbox');
  const lightboxImage = document.querySelector<HTMLImageElement>('.js-lightbox-image');
  const openers = document.querySelectorAll<HTMLButtonElement>('.js-lightbox-open');
  const closeBtn = document.querySelector<HTMLButtonElement>('.js-lightbox-close');
  const prevBtn = document.querySelector<HTMLButtonElement>('.js-lightbox-prev');
  const nextBtn = document.querySelector<HTMLButtonElement>('.js-lightbox-next');

  const items = Array.from(openers).map((btn) => ({
    src: btn.dataset.src ?? '',
    alt: btn.querySelector('img')?.alt ?? '',
  }));

  let currentIndex = 0;

  function showImage(index: number) {
    if (!lightboxImage || items.length === 0) return;
    currentIndex = (index + items.length) % items.length;
    const item = items[currentIndex];
    lightboxImage.src = item.src;
    lightboxImage.alt = item.alt;
  }

  function openLightbox(index: number) {
    if (!lightbox) return;
    showImage(index);
    lightbox.hidden = false;
    document.body.style.overflow = 'hidden';
  }

  function closeLightbox() {
    if (!lightbox) return;
    lightbox.hidden = true;
    document.body.style.overflow = '';
  }

  openers.forEach((btn, index) => {
    btn.addEventListener('click', () => openLightbox(index));
  });

  closeBtn?.addEventListener('click', closeLightbox);
  prevBtn?.addEventListener('click', () => showImage(currentIndex - 1));
  nextBtn?.addEventListener('click', () => showImage(currentIndex + 1));
  lightbox?.addEventListener('click', (e) => {
    if (e.target === lightbox) closeLightbox();
  });
  document.addEventListener('keydown', (e) => {
    if (lightbox?.hidden) return;
    if (e.key === 'Escape') closeLightbox();
    if (e.key === 'ArrowLeft') showImage(currentIndex - 1);
    if (e.key === 'ArrowRight') showImage(currentIndex + 1);
  });
</script>

<style>
  .work-detail {
    padding-bottom: clamp(3rem, 8vw, 6rem);
  }

  .work-detail__header {
    text-align: center;
    margin-bottom: clamp(2.5rem, 6vw, 4rem);
  }

  .work-detail__header h1 {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: clamp(2.1rem, 5vw, 3.25rem);
    margin: 0 0 0.75rem;
  }

  .work-detail__title-en {
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--color-text-muted);
    margin: 0 0 1.5rem;
  }

  .work-detail__meta {
    color: var(--color-text-muted);
    margin: 0.15rem 0;
    white-space: pre-line;
  }

  .work-detail__year {
    color: var(--color-text-muted);
    font-size: 0.85rem;
    margin-top: 1rem;
  }

  .work-detail__gallery {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  .work-detail__gallery-group {
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
  }

  .work-detail__gallery-group-label {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 1rem;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
    margin: 0 0 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .work-detail__gallery--standalone {
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
  }

  .work-detail__gallery-item {
    display: block;
    width: 100%;
    padding: 0;
    border: none;
    background: none;
    cursor: zoom-in;
  }

  .work-detail__gallery-item img {
    display: block;
    width: 100%;
    object-fit: cover;
  }

  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(1.5rem, 5vw, 4rem);
    background: rgba(20, 20, 18, 0.94);
  }

  .lightbox[hidden] {
    display: none;
  }

  .lightbox__image {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  .lightbox__close {
    position: fixed;
    top: clamp(1rem, 3vw, 2rem);
    right: clamp(1rem, 3vw, 2rem);
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid rgba(255, 255, 255, 0.4);
    background: transparent;
    color: #fff;
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
    transition: border-color 0.2s ease;
  }

  .lightbox__close:hover {
    border-color: #fff;
  }

  .lightbox__nav {
    position: fixed;
    top: 50%;
    transform: translateY(-50%);
    width: 3rem;
    height: 3rem;
    border: 1px solid rgba(255, 255, 255, 0.4);
    background: transparent;
    color: #fff;
    font-size: 1.75rem;
    line-height: 1;
    cursor: pointer;
    transition: border-color 0.2s ease;
  }

  .lightbox__nav:hover {
    border-color: #fff;
  }

  .lightbox__nav--prev {
    left: clamp(1rem, 3vw, 2rem);
  }

  .lightbox__nav--next {
    right: clamp(1rem, 3vw, 2rem);
  }

  .work-detail__video {
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
  }

  .work-detail__video video {
    display: block;
    width: 100%;
    background: var(--color-border);
  }

  .work-detail__specs {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.4rem 1rem;
    max-width: 32rem;
    margin: 0 auto clamp(2rem, 5vw, 3.5rem);
    font-size: 0.9rem;
  }

  .work-detail__specs dt {
    color: var(--color-text-muted);
  }

  .work-detail__specs dd {
    margin: 0;
  }

  .work-detail__body {
    max-width: 42rem;
    margin: 0 auto clamp(3rem, 6vw, 4rem);
  }

  .work-detail__body :global(a) {
    text-decoration: underline;
    text-underline-offset: 0.15em;
    text-decoration-color: var(--color-border);
    transition: text-decoration-color 0.2s ease;
  }

  .work-detail__body :global(a:hover) {
    text-decoration-color: var(--color-text);
  }

  .work-detail__back {
    display: block;
    text-align: center;
    color: var(--color-text-muted);
  }
</style>
