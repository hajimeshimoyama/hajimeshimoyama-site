---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const works = await getCollection('works');
  return works.map((work) => ({
    params: { slug: work.id },
    props: { work },
  }));
}

const { work } = Astro.props;
const { title, titleEn, year, venue, period, materials, size, images, coverImage } = work.data;
const gallery = images.length > 0 ? images : [coverImage];
const { Content } = await render(work);
---

<BaseLayout title={`${title} — Hajime Shimoyama`}>
  <article class="wrap work-detail">
    <header class="work-detail__header">
      <h1>{title}</h1>
      {titleEn && <p class="work-detail__title-en">{titleEn}</p>}
      {venue && <p class="work-detail__meta">{venue}</p>}
      {period && <p class="work-detail__meta">{period}</p>}
      <p class="work-detail__year">{year}</p>
    </header>

    <div class="work-detail__gallery">
      {gallery.map((src) => (
        <img src={src} alt={title} loading="lazy" />
      ))}
    </div>

    {(materials || size) && (
      <dl class="work-detail__specs">
        {materials && (
          <>
            <dt>素材</dt>
            <dd>{materials}</dd>
          </>
        )}
        {size && (
          <>
            <dt>サイズ</dt>
            <dd>{size}</dd>
          </>
        )}
      </dl>
    )}

    <div class="work-detail__body">
      <Content />
    </div>

    <a href="/" class="work-detail__back">↑ Back to Top</a>
  </article>
</BaseLayout>

<style>
  .work-detail {
    padding-bottom: clamp(3rem, 8vw, 6rem);
  }

  .work-detail__header {
    text-align: center;
    margin-bottom: clamp(2.5rem, 6vw, 4rem);
  }

  .work-detail__header h1 {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(1.8rem, 4vw, 2.75rem);
    margin: 0 0 0.75rem;
  }

  .work-detail__title-en {
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--color-text-muted);
    margin: 0 0 1.5rem;
  }

  .work-detail__meta {
    color: var(--color-text-muted);
    margin: 0.15rem 0;
  }

  .work-detail__year {
    color: var(--color-text-muted);
    font-size: 0.85rem;
    margin-top: 1rem;
  }

  .work-detail__gallery {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
  }

  .work-detail__gallery img {
    width: 100%;
    object-fit: cover;
  }

  .work-detail__specs {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.4rem 1rem;
    max-width: 32rem;
    margin: 0 auto clamp(2rem, 5vw, 3.5rem);
    font-size: 0.9rem;
  }

  .work-detail__specs dt {
    color: var(--color-text-muted);
  }

  .work-detail__specs dd {
    margin: 0;
  }

  .work-detail__body {
    max-width: 42rem;
    margin: 0 auto clamp(3rem, 6vw, 4rem);
  }

  .work-detail__back {
    display: block;
    text-align: center;
    color: var(--color-text-muted);
  }
</style>
