---
interface Props {
  slug: string;
  title: string;
  year: number;
  coverImage: string;
  category: string;
}

const { slug, title, year, coverImage, category } = Astro.props;
---

<a class="work-card js-work-card" href={`/works/${slug}`} data-category={category}>
  <div class="work-card__image">
    <img src={coverImage} alt={title} loading="lazy" />
  </div>
  <p class="work-card__title">{title}</p>
  <p class="work-card__year">{year}</p>
</a>

<style>
  .work-card {
    display: block;
    text-align: center;
  }

  .work-card__image {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--color-border);
    margin-bottom: 1.25rem;
  }

  .work-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .work-card:hover .work-card__image img {
    transform: scale(1.03);
  }

  .work-card__title {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 1.15rem;
    margin: 0 0 0.35rem;
  }

  .work-card__year {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    margin: 0;
  }
</style>
